{% schema %}
{
  "name": "Sock Club Promo",
  "settings": [
    {
      "type": "header",
      "content": "Images & Layout"
    },
    {
      "type": "image_picker",
      "id": "desktop_bg_image",
      "label": "Desktop Background Image",
      "info": "This image acts as the background for desktop views."
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile Logo Image",
      "info": "Displays at the top of the section on mobile devices."
    },
    {
      "type": "select",
      "id": "desktop_alignment",
      "label": "Desktop Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh B.O.M.Socks. Delivered monthly. Full of goodness."
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "<p>Join the club and get a new pair of faith-filled, conversation-starting socks delivered to your door every month.</p><p>Perfect for missionaries, ministering, gifts, Sunday best, or just keeping your sock drawer from looking like it wandered in the wilderness for 40 years.</p>"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Join the Club"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label",
      "default": "See How It Works"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Mobile Background Color",
      "default": "#000000",
      "info": "Used as the background color on mobile when the desktop image is hidden."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Primary Button Background",
      "default": "#ebb30b"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Primary Button Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_border_color_2",
      "label": "Secondary Button Border",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color_2",
      "label": "Secondary Button Text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Sock Club Promo",
      "category": "Promotional"
    }
  ]
}
{% endschema %}

<style>
  .sock-promo-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.desktop_bg_image %}
    background-image: url('{{ section.settings.desktop_bg_image | img_url: "master" }}');
    {% endif %}
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    padding: 100px 40px;
    min-height: 35vw;
    display: flex;
    align-items: center;
  }

  .sock-promo-container-{{ section.id }} {
    max-width: 1350px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    justify-content: {% if section.settings.desktop_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  .sock-promo-content-{{ section.id }} {
    max-width: 550px; /* Slightly wider to accommodate side-by-side buttons cleanly */
  }

  .sock-promo-mobile-logo-{{ section.id }} {
    display: none;
    max-width: 250px;
    margin: 0 auto 30px auto;
  }

  .sock-promo-heading-{{ section.id }} {
    font-weight: 700;
    margin-bottom: 20px;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
  }

  .sock-promo-text-{{ section.id }} {
    margin-bottom: 30px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
  }

  .sock-promo-buttons-{{ section.id }} {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }

  .sock-promo-btn-{{ section.id }} {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: 14px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.3s ease;
    text-align: center;
  }

  .sock-promo-btn-{{ section.id }}:hover {
    opacity: 0.85;
  }

  .sock-promo-btn-secondary-{{ section.id }} {
    display: inline-block;
    background-color: transparent;
    color: {{ section.settings.button_text_color_2 }};
    border: 2px solid {{ section.settings.button_border_color_2 }};
    padding: 12px 30px; /* Slightly less padding to account for the border thickness */
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    text-align: center;
  }

  .sock-promo-btn-secondary-{{ section.id }}:hover {
    background-color: {{ section.settings.button_border_color_2 }};
    color: {{ section.settings.bg_color }};
  }

  /* Responsive Mobile Styles */
  @media screen and (max-width: 768px) {
    .sock-promo-{{ section.id }} {
      background-image: none; /* Disables the large desktop background */
      padding: 60px 20px;
      min-height: auto;
    }

    .sock-promo-container-{{ section.id }} {
      justify-content: center;
      text-align: center;
    }

    .sock-promo-content-{{ section.id }} {
      max-width: 100%;
    }

    .sock-promo-mobile-logo-{{ section.id }} {
      display: block; /* Reveals the logo stacked on top */
    }

    .sock-promo-buttons-{{ section.id }} {
      justify-content: center;
    }
  }
</style>

<div class="sock-promo-{{ section.id }}">
  <div class="sock-promo-container-{{ section.id }}">
    <div class="sock-promo-content-{{ section.id }}">

      {% if section.settings.mobile_logo %}
        <img src="{{ section.settings.mobile_logo | img_url: '500x' }}"
             alt="{{ section.settings.mobile_logo.alt | escape }}"
             class="sock-promo-mobile-logo-{{ section.id }}">
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="sock-promo-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.paragraph != blank %}
        <div class="sock-promo-text-{{ section.id }}">{{ section.settings.paragraph }}</div>
      {% endif %}

      <div class="sock-promo-buttons-{{ section.id }}">
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="sock-promo-btn-{{ section.id }}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {% if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank %}
          <a href="{{ section.settings.button_link_2 }}" class="sock-promo-btn-secondary-{{ section.id }}">
            {{ section.settings.button_label_2 }}
          </a>
        {% endif %}
      </div>

    </div>
  </div>
</div>