<script>
  (function () {
    /* ---------- Scroll reveal (subtle fade-up) ---------- */
    var reveals = document.querySelectorAll('.bom-reveal');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('bom-in');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -5% 0px' });
      reveals.forEach(function (el) { io.observe(el); });
    } else {
      reveals.forEach(function (el) { el.classList.add('bom-in'); });
    }

    /* ---------- Testimonial slider (Swiper): loop + autoplay every 3s + arrows ---------- */
    var swiperEl = document.querySelector('.bom-swiper');
    if (swiperEl && window.Swiper) {
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      new Swiper(swiperEl, {
        loop: true,
        speed: 600,
        autoplay: reduceMotion ? false : {
          delay: 3000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        slidesPerView: 1.15,
        spaceBetween: 12,
        breakpoints: {
          768: { slidesPerView: 4, spaceBetween: 25 }
        },
        pagination: {
          el: '.bom-swiper-pagination',
          clickable: true
        }
      });
    }

    /* ---------- Keep video autoplay smooth: play in view, pause off-screen ----------
       (query after Swiper init so loop-mode duplicate slides are included) */
    var vids = document.querySelectorAll('.bom-swiper video');
    if ('IntersectionObserver' in window && vids.length) {
      var vio = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var v = entry.target;
          if (entry.isIntersecting) {
            var p = v.play();
            if (p && p.catch) { p.catch(function () {}); }
          } else {
            v.pause();
          }
        });
      }, { threshold: 0.35 });
      vids.forEach(function (v) { vio.observe(v); });
    }
  })();
</script>
