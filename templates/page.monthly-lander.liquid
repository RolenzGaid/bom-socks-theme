  .bom-reveal[data-delay="1"] { transition-delay: .12s; }
  .bom-reveal[data-delay="2"] { transition-delay: .24s; }
  .bom-reveal[data-delay="3"] { transition-delay: .36s; }
  @media (prefers-reduced-motion: reduce) {
    .bom-reveal { opacity: 1; transform: none; transition: none; }
