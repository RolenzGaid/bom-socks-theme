    --bom-text: #1a1a1a;
    --bom-text-light: #f5f5f5;

    --bom-font-body: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --bom-font-script: 'Michland Script', cursive;

    font-family: var(--bom-font-body);
    color: var(--bom-text);
    margin: 0;
    width: 100%;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  .bom-lp *, .bom-lp *::before, .bom-lp *::after { box-sizing: border-box; }
  .bom-lp img { display: block; max-width: 100%; height: auto; }
  .bom-lp h1, .bom-lp h2, .bom-lp h3, .bom-lp p, .bom-lp ul { margin: 0; }
  .bom-lp ul { padding: 0; list-style: none; }
  .bom-lp a { text-decoration: none; color: inherit; }

  .bom-container { width: 75vw; margin-inline: auto; }

  .bom-script { font-family: var(--bom-font-script); font-weight: 400; text-transform: none !important; }

