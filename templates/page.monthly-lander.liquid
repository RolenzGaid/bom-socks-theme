<style>

  .shopify-section-group-header-group, .shopify-section-group-footer-group {
      display: none;
  }

  /* ---------- Fonts ---------- */
  @font-face {
    font-family: 'Michland Script';
    src: url('https://cdn.shopify.com/s/files/1/1726/6105/files/Michland_Script.otf?v=1784577919') format('opentype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  /* ---------- Tokens ---------- */
  .bom-lp {
    --bom-black: #0d0d0d;
    --bom-off-black: #141414;
    --bom-white: #ffffff;
    --bom-gray-bg: #f2f2f2;
