  .bom-badge--dark { color: var(--bom-white); border-color: var(--bom-yellow); }
  .bom-badge--light { color: var(--bom-text); border-color: var(--bom-gold); }
  .bom-badge .bom-spark { color: var(--bom-yellow); }
  .bom-badge--light .bom-spark { color: var(--bom-gold); }

