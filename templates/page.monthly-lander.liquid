  .bom-lp a.bom-btn, .bom-lp a.bom-btn:visited { text-decoration: none !important; }
  .bom-lp .bom-btn--black, .bom-lp .bom-btn--black:visited { background: var(--bom-black) !important; color: var(--bom-yellow) !important; }
  .bom-lp .bom-btn--black .bom-btn-arrow { color: var(--bom-yellow) !important; }
  .bom-lp .bom-btn--gold, .bom-lp .bom-btn--gold:visited { color: var(--bom-black) !important; }
  .bom-lp .bom-btn--outline, .bom-lp .bom-btn--outline:visited { color: var(--bom-text) !important; }

