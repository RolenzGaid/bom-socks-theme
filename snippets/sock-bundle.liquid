{% comment %}
  Renders the "Sock bundle" pack-size selector for the product page.

  Accepts:
  - block: the `sock_bundle` block from sections/main-product.liquid
  - section: the main-product section
  - product: the current product

  Usage:
  {% render 'sock-bundle', block: block, section: section, product: product %}
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<sock-bundle
  class="sock-bundle"
  id="SockBundle-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-title="{{ product.title | escape }}"
  data-product-image="{{ product.featured_image | image_url: width: 200 }}"
  data-product-price="{{ current_variant.price }}"
  data-picker-replaces-gallery="{{ block.settings.picker_replaces_gallery }}"
  data-prefill-current="{{ block.settings.prefill_current_product }}"
  data-hide-default-atc="{{ block.settings.hide_default_buy_buttons }}"
  data-after-add="{{ block.settings.after_add_to_cart }}"
  data-cart-url="{{ routes.cart_url }}"
  data-slots-heading="{{ block.settings.slots_heading | default: 'Your socks' | escape }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  style="
    --sb-badge-bg: {{ block.settings.badge_background }};
    --sb-badge-text: {{ block.settings.badge_text_color }};
    --sb-note-bg: {{ block.settings.note_background }};
    --sb-note-text: {{ block.settings.note_text_color }};
  "
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-sock-bundle-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | remove: 'Default Title' | json }},
          "price": {{ variant.price | json }},
          "image": {{ variant.image | default: product.featured_image | image_url: width: 200 | json }},
          "available": {{ variant.available | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  {%- if block.settings.heading != blank or block.settings.show_step_number -%}
    <div class="sock-bundle__head">
      {%- if block.settings.show_step_number -%}
        <span class="sock-bundle__step">{{ block.settings.step_number | default: 1 }}</span>
      {%- endif -%}
      {%- if block.settings.heading != blank -%}
        <h2 class="sock-bundle__heading">{{ block.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- liquid
    assign enabled_count = 1
    if block.settings.tier2_enable
      assign enabled_count = enabled_count | plus: 1
    endif
    if block.settings.tier3_enable
      assign enabled_count = enabled_count | plus: 1
    endif
    if block.settings.tier4_enable
      assign enabled_count = enabled_count | plus: 1
    endif
  -%}

  <div
    class="sock-bundle__tiers"
    role="radiogroup"
    aria-label="{{ block.settings.heading | default: 'Pack size' | escape }}"
    style="--sb-tier-count: {{ enabled_count }};"
  >
    <button
      type="button"
      class="sock-bundle__tier"
      role="radio"
      aria-checked="true"
      data-sock-tier
      data-qty="1"
      data-code=""
    >
      <span class="sock-bundle__tier-label">
        {{- block.settings.single_label | default: 'Single' | escape -}}
      </span>
      {%- if block.settings.single_sub != blank -%}
        <span class="sock-bundle__tier-sub">{{ block.settings.single_sub | escape }}</span>
      {%- endif -%}
    </button>

    {%- for i in (2..4) -%}
      {%- liquid
        case i
          when 2
            assign t_enabled = block.settings.tier2_enable
            assign t_label = block.settings.tier2_label
            assign t_badge = block.settings.tier2_badge
            assign t_note = block.settings.tier2_note
            assign t_code = block.settings.tier2_code
            assign t_sub = block.settings.tier2_sub
          when 3
            assign t_enabled = block.settings.tier3_enable
            assign t_label = block.settings.tier3_label
            assign t_badge = block.settings.tier3_badge
            assign t_note = block.settings.tier3_note
            assign t_code = block.settings.tier3_code
            assign t_sub = block.settings.tier3_sub
          when 4
            assign t_enabled = block.settings.tier4_enable
            assign t_label = block.settings.tier4_label
            assign t_badge = block.settings.tier4_badge
            assign t_note = block.settings.tier4_note
            assign t_code = block.settings.tier4_code
            assign t_sub = block.settings.tier4_sub
        endcase

        capture t_fallback
          echo i
          echo ' Pack'
        endcapture
        assign t_label = t_label | default: t_fallback
      -%}

      {%- if t_enabled -%}
        <button
          type="button"
          class="sock-bundle__tier"
          role="radio"
          aria-checked="false"
          data-sock-tier
          data-qty="{{ i }}"
          data-code="{{ t_code | strip | escape }}"
        >
          {%- if t_badge != blank -%}
            <span class="sock-bundle__tier-badge">{{ t_badge | escape }}</span>
          {%- endif -%}
          <span class="sock-bundle__tier-label">{{ t_label | strip | escape }}</span>
          {%- if t_sub != blank -%}
            <span class="sock-bundle__tier-sub">{{ t_sub | escape }}</span>
          {%- endif -%}
          {%- if t_note != blank -%}
            <span class="sock-bundle__tier-note">{{ t_note | escape }}</span>
          {%- endif -%}
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="sock-bundle__slots-wrap" data-sock-bundle-slots-wrap hidden>
    <div class="sock-bundle__slots-title">
      <span>{{ block.settings.slots_heading | default: 'Your socks' | escape }}</span>
      <span class="sock-bundle__slots-count" data-sock-bundle-progress></span>
    </div>
    <div class="sock-bundle__slots" role="list" data-sock-bundle-slots></div>

    {%- if block.settings.show_total -%}
      <div class="sock-bundle__summary" data-sock-bundle-summary hidden>
        <span class="sock-bundle__summary-total" data-sock-bundle-total></span>
      </div>
    {%- endif -%}

    <button
      type="button"
      class="button button--solid button--medium sock-bundle__atc"
      data-sock-bundle-atc
      disabled
    >
      {{ block.settings.atc_text | default: 'Add bundle to cart' | escape }}
    </button>

    <p class="sock-bundle__error" data-sock-bundle-error role="alert"></p>
  </div>
</sock-bundle>
